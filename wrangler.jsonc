{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",

  "name": "hehwhwhwhuuu",

  "main": "./worker.js",

  "compatibility_date": "2026-08-15",

  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "REPORTS"
    }
  ]
}
